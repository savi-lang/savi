// TODO: This should get moved into the SaviWorker library
:class _CLI
  :var port: SaviWorker.TCP.Listener.default_port

  :is CLI.Option.Data
  :fun non define_cli_options(defs CLI.Option.Defs) None
    defs.i64("port", 'p')

  :fun ref trace_data_mutable(trace TraceData.Mutator) None
    trace.object(identity_digest_of @) -> (key |
      case key == (
      | "port" | trace.replace_i64(@port) -> (v | @port = v)
      )
    )

:actor Main
  :let env Env
  :new (@env)
    // TODO: Most of this setup should get moved into the SaviWorker library
    cli = try (
      CLI.Parser(_CLI).parse!(_CLI.new, @env.args)
    | error |
      @env.err.print(error.message)
      @env.exit_code = 1
      return
    )
    log = _Log.new(@env.err, Logger.Level.Debug)

    SaviWorker.TCP.new(
      _Worker.new(@env, log)
      log
      TCP.auth(@env.root).connect.to("0.0.0.0", "\(cli.options.port)")
    )

// TODO: Most of this setup should get moved into the SaviWorker library
:actor _Worker
  :is SaviWorker

  :let env Env
  :let log _Log
  :let file_loader: File.Loader.new
  :let file_dumper: File.Dumper.new
  :new (@env, @log)

  :fun non kind: "declares"
  :var result_sink (SaviWorker.ResultSink | None): None
  :let pending_results Array(
    CapnProto.Message.Builder(SaviProto.Artifact.Invoke.Result.Builder)
  ): [] // TODO: This isn't enough to handle a future scenario where the file loading/dumping isn't causal

  :be set_result_sink(sink): @result_sink = sink

  :fun ref send_result None
    result = try (@pending_results.shift! |
      @log.error -> ("No pending result in the stack")
      return
    )

    final = try (
      CapnProto.Message(SaviProto.Artifact.Invoke.Result).from_val_segments!(
        result.take_val_segments
      )
    |
      @log.error -> ("Failed to finalize result")
      return
    )

    try (
      @result_sink.not!(None).work_result(final)
    |
      @log.error -> ("No result sink set")
    )

  :fun ref prep_result None
    :yields SaviProto.Artifact.Invoke.Result.Builder

    result = try (@pending_results.first! |
      @log.error -> ("No pending result in the stack")
      return
    )

    yield result.root

  :fun ref send_error(message String) None
    @prep_result -> (result |
      result.init_errors(1)
      try (result.errors[0]!.message = message) // "cannot fail"
    )
    @send_result

  :fun ref send_error_bug(message String) None
    @send_error(message)
    @log.error -> (message)

  :be work(invoke CapnProto.Message(SaviProto.Artifact.Invoke)'val)
    result = CapnProto.Message.Builder(SaviProto.Artifact.Invoke.Result.Builder).new(0x4000)
    result.root.id = invoke.root.id
    @pending_results << result

    if invoke.root.inputs.size != 1 (
      return @send_error("declares step expects \
        1 input per invoke, but got \(invoke.root.inputs.size)")
    )

    input = try (invoke.root.inputs[0]! | return)

    if "\(input.name.kind)" != "parse" ( // TODO: no string interpolation
      return @send_error("declares step expects \
        a parse artifact as input, but got \(input.name.kind)")
    )

    source = try (input.name.source! |
      return @send_error("declares step expects a source-level artifact as input")
    )

    try (
      output = result.root.init_outputs(1)[0]!
      output.name.copy_data_from(input.name)
      output.name.kind = "declares"
    |
      @send_error_bug("Output artifact list was not initialized")
    )

    path = SaviProto.Artifact.Path.read_from(
      SaviProto.Artifact.Path.read_root(@env.root)
      input
    )
    @log.debug -> ("Loading file from \(path.string)")
    @file_loader.load_from_file(path, @)

  :is File.Loader.ResultActor
  :be result_of_load_from_file(
    path File.Path.Readable
    result File.Result
    content Bytes'iso
  )
    if result != File.Result.Success (
      return @send_error("Error loading file from \(path.string): \(result)")
    )
    @log.debug -> ("Loaded file from \(path.string)")

    stream = ByteStream.Pair.new
    stream.write << --content
    try stream.write.flush!

    reader = CapnProto.Segments.Reader.new
    try (
      res = reader.read!(stream.read)
      if !res (
        return @send_error("Incomplete data at \(path.string)")
      )
    |
      return @send_error("Failed to read the data at \(path.string)")
    )

    in_message = try (
      CapnProto.Message(SaviProto.AST.RawDocument)
        .from_segments!(reader.take_segments)
    |
      return @send_error("Failed to parse data from \(path.string)")
    )

    declarators_message = CapnProto.Message.Builder(
      SaviProto.Declarator.Analysis.Builder
    ).new(0x4000)
    _Bootstrap.Declarators.set_up(declarators_message.root)


    out_message = CapnProto.Message.Builder(
      SaviProto.Declarator.Analysis.Builder
    ).new(0x4000)

    declarator_count = _GatherDeclarators.count_max(in_message.root)
    Inspect.out("declarator_count: \(declarator_count)")

    _GatherDeclarators.gather(
      declarators_message.root
      in_message.root
    )

